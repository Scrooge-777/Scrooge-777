{
  "version": 2,
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/card"
    },
    {
      "source": "/card",
      "destination": "/api/card"
    },
    {
      "source": "/card.svg",
      "destination": "/api/card"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "functions": {
    "api/card.js": {
      "includeFiles": "assets/**"
    }
  }
}
