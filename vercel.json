{
  "version": 2,
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/card"
    },
    {
      "source": "/card",
      "destination": "/api/card"
    },
    {
      "source": "/card.svg",
      "destination": "/api/card"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; style-src 'unsafe-inline';"
        }
      ]
    }
  ],
  "functions": {
    "api/card.js": {
      "includeFiles": "docs/**"
    }
  }
}
